#----- Merging the datasets ----------------------------------------------------------------------------------------------------------------------------------------------------

# Note: inner join returns matching values in both tables
imdb_merged = pd.merge(imdb_movies, imdb_ratings, how = "inner", on = "imdb_title_id")
